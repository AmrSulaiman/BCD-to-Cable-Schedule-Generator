{
  "name": "bcd-cable-schedule",
  "version": "1.0.0",
  "description": "Turns block cable diagram PDFs into a filled cable schedule (Excel). Runs in the browser.",
  "scripts": {
    "build": "node build.mjs",
    "build:local": "node build.mjs --local",
    "extract": "node cli.mjs out.json",
    "test": "node test/run-all.mjs",
    "test:update-baseline": "node test/run-all.mjs --update-baseline"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "pdfjs-dist": "^4.10.38"
  },
  "type": "module",
  "devDependencies": {
    "@napi-rs/canvas": "^0.1.65",
    "esbuild": "^0.24.2"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
